<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Halo Outlook Extension — Add-in Manifest
  =========================================

  Deployer instructions:
  1. Replace @source_location@ with your hosted add-in URL (e.g. https://your-domain.com)
  2. Upload this file to Microsoft 365 Admin Center → Integrated Apps
  3. The add-in appears in Outlook within minutes

  Required Azure AD app permissions for the add-in:
  - Mail.ReadWrite (to read email content and conversation metadata)
  - Mail.Send (if the OnSend handler needs to modify emails before sending)

  The add-in uses Office.js + React. Static assets are built via `npm run build`
  and hosted at the SourceLocation URL.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="MailApp">

  <!-- Basic metadata -->
  <Id>e1c9c6fa-e332-49db-8a4a-4c71dd59d4aa</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Fireside IT Partners</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Halo Ticket Bridge" />
  <Description DefaultValue="Create and track HaloPSA tickets from Outlook email conversations. Click to link a conversation to a ticket — future replies automatically journal." />
  <IconUrl DefaultValue="@source_location@/assets/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="@source_location@/assets/icon-128.png" />
  <SupportUrl DefaultValue="https://github.com/timothiasthegreat/halo-outlook-extension" />

  <!-- Host requirements: Outlook on desktop and web -->
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.8">
      <Set Name="Mailbox" />
    </Sets>
  </Requirements>

  <!-- Outlook-specific settings -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="@source_location@/taskpane.html" />
        <RequestedHeight>350</RequestedHeight>
      </DesktopSettings>
      <TabletSettings>
        <SourceLocation DefaultValue="@source_location@/taskpane.html" />
        <RequestedHeight>350</RequestedHeight>
      </TabletSettings>
      <PhoneSettings>
        <SourceLocation DefaultValue="@source_location@/taskpane.html" />
      </PhoneSettings>
    </Form>
  </FormSettings>

  <!-- Permissions: ReadWriteMailbox for reading conversation metadata and email content -->
  <Permissions>ReadWriteMailbox</Permissions>

  <!-- Rule: activate for message read (reading pane and pop-out) -->
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <!-- Version overrides: adds taskpane pinning and OnMessageSend -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.0" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.8">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <!-- Task pane: shown in reading pane -->
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadGroup">
                <Label resid="groupLabel" />
                <Control xsi:type="Button" id="openTaskpane">
                  <Label resid="paneReadButtonLabel" />
                  <Supertip>
                    <Title resid="paneReadButtonTitle" />
                    <Description resid="paneReadButtonDescription" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="taskpaneUrl" />
                    <SupportsPinning>true</SupportsPinning>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

          <!-- OnMessageSend: intercept outbound sends -->
          <ExtensionPoint xsi:type="Events">
            <Event Type="OnMessageSend" FunctionExecution="synchronous" FunctionName="onMessageSendHandler" />
          </ExtensionPoint>
        </DesktopFormFactor>

        <MobileFormFactor>
          <ExtensionPoint xsi:type="MobileMessageReadCommandSurface">
            <Group id="mobileMsgReadGroup">
              <Label resid="groupLabel" />
              <Control xsi:type="MobileButton" id="mobileOpenTaskpane">
                <Label resid="paneReadButtonLabel" />
                <Icon>
                  <bt:Image size="25" resid="icon25" />
                  <bt:Image size="32" resid="icon32" />
                  <bt:Image size="48" resid="icon48" />
                </Icon>
                <Action xsi:type="ShowTaskpane">
                  <SourceLocation resid="taskpaneUrl" />
                </Action>
              </Control>
            </Group>
          </ExtensionPoint>
        </MobileFormFactor>
      </Host>
    </Hosts>

    <!-- Resource strings (resid → values) -->
    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="@source_location@/assets/icon-16.png" />
        <bt:Image id="icon25" DefaultValue="@source_location@/assets/icon-25.png" />
        <bt:Image id="icon32" DefaultValue="@source_location@/assets/icon-32.png" />
        <bt:Image id="icon48" DefaultValue="@source_location@/assets/icon-48.png" />
        <bt:Image id="icon64" DefaultValue="@source_location@/assets/icon-64.png" />
        <bt:Image id="icon80" DefaultValue="@source_location@/assets/icon-80.png" />
        <bt:Image id="icon128" DefaultValue="@source_location@/assets/icon-128.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="taskpaneUrl" DefaultValue="@source_location@/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="groupLabel" DefaultValue="Halo Ticket Bridge" />
        <bt:String id="paneReadButtonLabel" DefaultValue="Link to Halo" />
        <bt:String id="paneReadButtonTitle" DefaultValue="Halo Ticket Bridge" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="paneReadButtonDescription" DefaultValue="Create or link a HaloPSA ticket from this email conversation. Future replies automatically journal to the ticket." />
      </bt:LongStrings>
    </Resources>

    <!-- OnMessageSend handler — JavaScript function reference -->
    <ExtendedPermissions>
      <ExtendedPermission>OnMessageSend</ExtendedPermission>
    </ExtendedPermissions>
  </VersionOverrides>
</OfficeApp>