# Halo Outlook Extension - Environment Variables
# Copy this to .env and fill in your values

# Fernet encryption key for refresh tokens at rest (44-char base64)
# Auto-generated on first Docker run if missing — only needed for local dev
FERNET_KEY=

# Microsoft Graph (for Watcher email monitoring)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=