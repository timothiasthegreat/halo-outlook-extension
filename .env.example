# Halo Outlook Extension - Environment Variables
# Copy this to .env and fill in your values

# HaloPSA OAuth (authorization code flow with PKCE — primary auth method)
# From Configuration → Integrations → Halo API → OAuth Application
HALO_CLIENT_ID=
HALO_CLIENT_SECRET=

# HaloPSA Instance URL (e.g. https://service.firesideit.ca/api)
HALO_API_BASE_URL=https://your-instance.halopsa.com/api

# Microsoft Graph (for Watcher email monitoring)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_USER_EMAIL=